{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认能力: 允许前端调用内置命令与接收事件",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-title"
  ]
}